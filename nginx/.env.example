# nginx가 로컬 dev에서 리슨할 포트. 비워두면(기본값) 8080을 쓴다.
# scripts/start-dev.ps1/stop-dev.ps1이 이 값을 읽어 nginx.conf.template을
# 실제 포트로 치환한 뒤 기동한다(nginx.generated.conf, 커밋 대상 아님).
# 다른 프로그램이 8080을 이미 쓰고 있을 때만 바꾸면 된다 — 예) NGINX_PORT=8081
NGINX_PORT=

# nginx가 자체 서명 인증서로 HTTPS를 같이 내줄 포트. 비워두면(기본값) 8443을
# 쓴다. scripts/setup-local-https.ps1로 nginx/certs/에 인증서를 생성해둔
# 경우에만 실제로 열린다(인증서가 없으면 start-dev.ps1이 이 블록 자체를
# nginx 설정에서 빼버리므로, 지금까지처럼 HTTP만 쓰는 사람에게는 영향 없음).
# 실제 사내 SSO 브로커가 콜백(redirect_uri)에 HTTPS를 요구할 때 필요하다 —
# README.md "다른 서버로 옮겨서 실제 SSO 브로커에 연동하기" H번 절 참고.
NGINX_HTTPS_PORT=
