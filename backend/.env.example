APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATA_DIR=data
CURRENT_YEAR=2026
CURRENT_MONTH_OVERRIDE=

# 데이터 계층 접속 문자열. 비워두면 DATA_DIR 아래 sqlite 파일(data/app.db)을 쓴다.
# 1단계(현재): SQLite, 예) sqlite:///./data/app.db
# 2단계(향후): PostgreSQL, 예) postgresql+psycopg://user:password@host:5432/ims
# 운영에서는 항상 Secret으로 주입한다 — SQLite 단계에서는 비민감 값이지만,
# 배포 계약(env var 이름)을 단계 간 동일하게 유지하기 위해 처음부터 Secret으로
# 취급한다(docs/ENV_AND_SECRETS.md 참고).
DATABASE_URL=

# 로깅 레벨 (DEBUG/INFO/WARNING/ERROR). 기본값 INFO.
LOG_LEVEL=INFO

# 콤마로 구분된 허용 Origin 목록. 비워두면 로컬 dev 기본값
# (http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080) 사용.
# 운영 배포 시 Nginx가 동일 origin에서 /api를 프록시하면 이 값 자체가
# 불필요해질 수 있다 — 실제 배포 구조 확정 후 재검토.
CORS_ORIGINS=
