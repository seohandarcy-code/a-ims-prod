# APP_ENV/HOST/PORT: 참고용으로만 남겨둔다 — 코드 어디에서도 실제로 읽지 않는다.
# 바인드 주소/포트는 scripts/start-dev.ps1에 하드코딩된 uvicorn 인자(현재
# --host 127.0.0.1 --port 8000)가 결정한다. 다른 서버에서 바인드 주소를 바꾸려면
# (예: 0.0.0.0으로 열어 사내망에 노출) 그 스크립트를 직접 고치거나 uvicorn을
# --host/--port를 지정해 수동 실행해야 한다 — 바인드 주소는 보안에 영향을 주므로
# env var 하나로 조용히 바뀌지 않게 의도적으로 분리해뒀다.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATA_DIR=data
CURRENT_YEAR=2026
CURRENT_MONTH_OVERRIDE=

# --- 데이터 계층 접속 정보 ---
# app/config.py의 _build_database_url()이 아래 우선순위로 DATABASE_URL을 결정한다.
# 자세한 설명/설정 방법은 README.md "환경변수와 Secret" 절 참고.
#
# 1) DATABASE_URL을 직접 채우면 그 값을 그대로 쓴다(아래 DB_* 값은 전부 무시됨).
#    비워두면(기본값, 아래처럼 그대로 두면 됨) DATA_DIR 아래 sqlite 파일(data/app.db)을
#    쓴다 — fresh clone 직후 별도 설정 없이 바로 실행되는 것이 이 기본값 덕분이다.
#    예시(README.md "PostgreSQL로 전환해서 개발하기" 절 기준으로 실제 로컬 검증한 값):
# DATABASE_URL=postgresql+psycopg://ims_dev:ims_dev_local_pw@127.0.0.1:5432/ims_dev
DATABASE_URL=

# 2) DATABASE_URL을 비워두고 DB_HOST만 채우면, 아래 5개 값을 조합해 DSN을 자동으로
#    만든다(문자열을 직접 조립하지 않아도 되고, 값에 특수문자가 있어도 안전하게
#    인코딩된다). 배포 환경에서 host/port/name은 ConfigMap, user/password는 Secret으로
#    나눠 관리하고 싶을 때 이 방식을 쓴다. DB_PORT/DB_NAME은 비우면 각각 5432/ims로
#    채워진다. 예시(위 DATABASE_URL 예시와 동일한 접속 정보를 분리해서 쓴 것):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=ims_dev
# DB_USER=ims_dev
# DB_PASSWORD=ims_dev_local_pw
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# 운영(PDEP)에서는 DATABASE_URL(또는 DB_PASSWORD)을 항상 Secret으로 주입한다 —
# SQLite 단계에서는 DATABASE_URL이 비민감 값이지만, 배포 계약(env var 이름)을 단계
# 간 동일하게 유지하기 위해 처음부터 Secret으로 취급한다(docs/ENV_AND_SECRETS.md 참고).

# 관리자 초기 비밀번호. 비워두면 기존 기본값("0000")을 그대로 쓴다(로컬 개발 편의).
# 서버가 재기동될 때마다 항상 이 값으로 리셋된다(파일 영속화 안 함 — app/auth/state.py).
# 여러 서버에 배포할 때는 환경마다 다른 값을 Secret으로 넣어, 전부 같은 잘 알려진
# 기본 비밀번호를 공유하지 않도록 한다. 예시:
# ADMIN_BOOTSTRAP_PASSWORD=change-me-per-environment
ADMIN_BOOTSTRAP_PASSWORD=

# --- 로그인 수단(local/sso) ---
# local(기본값)이면 지금까지와 동일하게 아이디/비밀번호로 로그인하고 대시보드는
# 공개된다. sso로 바꾸면 대시보드 자체가 로그인 게이트 뒤로 들어간다 — 로그인한
# 사람 중에서도 DB(allowed_users, 관리자 화면 "접근 권한 관리" 탭)에 등록된 사람만
# 실제로 들어올 수 있고, 등록 시 admin 여부도 함께 정해진다(개인별 데이터 권한 아님,
# 접근 제어만). 세션 발급/검증 로직은 두 모드가 그대로 공유한다.
# 로컬 테스트 IdP(Keycloak) 설치 절차는 README.md "SSO로 전환해서 로그인 검증하기" 참고.
AUTH_MODE=local

# OAuth state/nonce를 담는 세션 쿠키 서명 키(SessionMiddleware, app/main.py). AUTH_MODE와
# 무관하게 항상 로드되지만 실제로 쓰이는 건 SSO 로그인 흐름뿐이다. 비워두면 기동할 때마다
# 무작위 값으로 자동 생성된다(app/config.py) — 로컬 개발은 이걸로 충분하지만, 그러면
# 재기동 시 진행 중이던 로그인 리다이렉트가 깨지고 여러 파드 환경에서는 파드마다 다른
# 키를 쓰게 되므로, 실 배포에서는 반드시 고정값을 Secret으로 넣는다. 예시(로컬 생성):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# 실제 HTTPS 배포에서는 true로 설정 — 위 세션 쿠키에 Secure 플래그를 붙여 평문
# HTTP로는 전송되지 않게 한다. 로컬 http 개발은 false(기본값)로 둔다 — true인데
# https가 아니면 브라우저가 쿠키 저장을 거부해 로그인 자체가 깨진다.
SESSION_COOKIE_SECURE=false

# 프론트/백엔드가 같은 origin이면(지금까지 로컬 개발 전제) 비워둔다. 도메인이
# 분리되는 배포(예: PDEP에서 프론트/백엔드 도메인을 따로 둠)라면 프론트의 실제
# 도메인을 채워야 SSO 콜백이 백엔드 자기 자신이 아니라 프론트로 정확히 돌아간다.
# 예: FRONTEND_BASE_URL=https://ims.company.com
FRONTEND_BASE_URL=

# 아래는 AUTH_MODE=sso일 때만 쓰인다. 예시는 README의 로컬 Keycloak 검증 기준.
# SSO_ISSUER_URL=http://127.0.0.1:8180/realms/ims
# SSO_CLIENT_ID=ims-backend
# SSO_CLIENT_SECRET=<Keycloak 클라이언트 시크릿>
# SSO_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/sso/callback
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=

# 브레이크글래스 admin 목록(콤마 구분, 아래 SSO_USER_ID_CLAIM 클레임 값과 대조).
# 실제 로그인 허용 여부는 DB의 allowed_users 테이블(관리자 화면 "접근 권한 관리"
# 탭)이 결정하지만, 이 목록에 있는 계정은 그 테이블 상태와 무관하게 로그인할 때마다
# admin으로 자동 등록/복구된다 — allowed_users를 잘못 건드려도(예: 실수로 admin을
# 전부 지움) 여기 있는 계정으로 항상 다시 들어올 수 있다. 최초 배포 시 반드시 한 명
# 이상 채워야 한다(안 그러면 allowed_users가 비어있는 상태에서 아무도 로그인할 수
# 없어 관리자 화면 자체에 못 들어가는 락아웃이 생긴다).
# 예시: SSO_ADMIN_ALLOWLIST=ims.admin@example.local,other.admin@example.local
SSO_ADMIN_ALLOWLIST=
# allowed_users.sso_id 및 위 브레이크글래스 목록과 대조할 클레임 이름. 표준 OIDC
# 클레임이 아니라 IdP마다 다르므로 실제 배포 전 IT팀에 확인 필요(사번/UPN 등 안정적인
# 고유 식별자 권장). 비우면 "email".
SSO_USER_ID_CLAIM=

# 로깅 레벨 (DEBUG/INFO/WARNING/ERROR). 기본값 INFO.
LOG_LEVEL=INFO

# 콤마로 구분된 허용 Origin 목록. 비워두면 로컬 dev 기본값
# (http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080) 사용.
# 운영 배포 시 Nginx가 동일 origin에서 /api를 프록시하면 이 값 자체가
# 불필요해질 수 있다 — 실제 배포 구조 확정 후 재검토.
CORS_ORIGINS=
